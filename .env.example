# Application
PORT=3000

# JWT
# Em produção defina um valor forte; em dev há fallback interno caso não esteja definido
JWT_SECRET=
JWT_EXPIRES_IN=15m
SALT_ROUNDS=10

# Database (PostgreSQL)
DATABASE_USER=example
DATABASE_PASSWORD=examplex
DATABASE_NAME=example_db
DATABASE_PORT=5432
DATABASE_URL="postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@localhost:${DATABASE_PORT}/${DATABASE_NAME}?schema=public"

# Prisma Cloud (opcional)
# DATABASE_URL="prisma+postgres://..."
